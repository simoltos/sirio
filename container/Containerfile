FROM docker.io/library/debian:bookworm-slim AS base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gcc \
        git \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*


FROM base AS runner-build

WORKDIR /src
COPY sirio_tool_runner.c .

RUN cc -std=c11 -O2 -Wall -Wextra -D_GNU_SOURCE -pthread \
    -o /sirio-tool-runner sirio_tool_runner.c


FROM base AS cma

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        chromium \
        python3 \
        python3-venv \
        python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=runner-build /sirio-tool-runner \
    /usr/local/bin/sirio-tool-runner

RUN mkdir -p /workspace
WORKDIR /workspace
CMD ["sleep", "infinity"]
